# Variables de entorno - MindFlow AI Fase 1
# Copiar este archivo a .env y completar los valores antes de levantar el proyecto

# --- Configuración del Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# --- Configuración CORS (Orígenes híbridos) ---
# Estos son los puertos que consumirán la API
CORS_ORIGINS_LOCAL=http://localhost:3000,http://localhost:19000,http://localhost:8080

# --- Configuración de Base de Datos (PostgreSQL v16) ---
# Para la Fase 1 mantenemos un valor simulado; se completará en Fase 3
POSTGRES_URL=sandbox+psycopg2://user:pass@localhost:5432/mindflow_ai_fase1
POSTGRES_USER=mindflow_user
POSTGRES_PASSWORD=mindflow_pass
POSTGRES_DB=mindflow_ai_fase1

# --- Configuración Redis v7 (Cache/Sessions) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- LLM Gateway ---
GEMINI_API_KEY=tu_clave_gemini_aqui
LLM_PROVIDER=google