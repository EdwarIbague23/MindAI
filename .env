# App
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://mindia:mindia@localhost:5432/mindia
ALLOW_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./mindflow.db
AUTO_CREATE_TABLES=true

# LLM
LLM_MODE=mock
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT_PER_MINUTE=30

# Security
ENABLE_PII_REDACTION=true
# Clave base64 de 32 bytes; si estÃ¡ vacÃ­a se deriva de SECRET_KEY (solo desarrollo)
AES_KEY=
LOG_LEVEL=INFO
ENABLE_CODE_EXECUTOR=false
REPORTS_DIR=reports
SPACY_MODEL=es_core_news_sm
