<mxfile host="app.diagrams.net" modified="2026-10-25T00:00:00.000Z" agent="Software Architect" version="24.7.17" type="device">
  <diagram id="architecture-diagram" name="MindFlow AI - Componentes por Capas">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Título -->
        <mxCell id="title" value="MindFlow AI - Arquitectura Híbrida de Capas" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="700" height="50" as="geometry"/>
        </mxCell>

        <!-- Capa 1: Presentación Web -->
        <mxCell id="layer-web" value="Capa 1: Presentación Web" style="swimlane;html=1;rounded=1;fillColor=#f8f9fa;strokeColor=#6c757d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="web-frontend" value="Frontend Web<br/><span style='color: #495057; fontSize: 12;'>React + TypeScript</span>" style="rounded=1;html=1;fillColor=#e9ecef;strokeColor=#6c757d;" vertex="1" parent="layer-web">
          <mxGeometry x="20" y="20" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="web-description" value="Portal para psicólogos, terapeutas, psiquiatras y gestión administrativa. Interfaz responsive, consumo de API unificada." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="layer-web">
          <mxGeometry x="20" y="80" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- Capa 2: Presentación Móvil -->
        <mxCell id="layer-mobile" value="Capa 2: Presentación Móvil" style="swimlane;html=1;rounded=1;fillColor=#f8f9fa;strokeColor=#6c757d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mobile-frontend" value="App Móvil<br/><span style='color: #495057; fontSize: 12;'>React Native</span>" style="rounded=1;html=1;fillColor=#e9ecef;strokeColor=#6c757d;" vertex="1" parent="layer-mobile">
          <mxGeometry x="20" y="20" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mobile-description" value="App Android/iOS para pacientes (diario emocional, seguimiento, citas) y profesionales (alertas prioritarias)." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="layer-mobile">
          <mxGeometry x="20" y="80" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- Capa 3: Aplicación -->
        <mxCell id="layer-app" value="Capa 3: Aplicación" style="swimlane;html=1;rounded=1;fillColor:#f0f9ff;strokeColor:#0284c7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="api-fastapi" value="API REST asíncrona<br/><span style='color: #0284c7; fontSize: 12;'>FastAPI (Python)</span>" style="rounded=1;html=1;fillColor=#e9f7fe;strokeColor:#0284c7;" vertex="1" parent="layer-app">
          <mxGeometry x="20" y="20" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="app-description" value="Servidor REST con validación Pydantic, documentación OpenAPI automática, manejo async/await para LLM calls y I/O de BD." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="layer-app">
          <mxGeometry x="20" y="80" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- Capa 4: Orquestación -->
        <mxCell id="layer-orch" value="Capa 4: Orquestación" style="swimlane;html=1;rounded=1;fillColor:#e0f2fe;strokeColor:#0284c7;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="orchestrator-core" value="Orchestrator Core<br/><span style='color: #0284c7; fontSize: 12;'>Router/Planner/Executor</span>" style="rounded=1;html=1;fillColor=#b3e5fc;strokeColor:#0284c7;" vertex="1" parent="layer-orch">
          <mxGeometry x="20" y="20" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="orch-description" value="Coordinador de agentes y skills de evaluación psicológica multidisciplinaria. Decomposición de tareas, enrutamiento y ejecución con fallback." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="layer-orch">
          <mxGeometry x="20" y="80" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- Capa 5: Infraestructura -->
        <mxCell id="layer-infra" value="Capa 5: Infraestructura" style="swimlane;html=1;rounded=1;fillColor:#faf0e6;strokeColor:#d97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="100" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="PostgreSQL v16<br/><span style='color: #667eea; fontSize: 12;'>BD relacional</span>" style="rounded=1;html=1;fillColor:#f0f4c3;strokeColor:#667eea;" vertex="1" parent="layer-infra">
          <mxGeometry x="20" y="20" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="postgres-desc" value="Garantías ACID, pgcrypto (AES-256-GCM) para cifrado de historias clínicas, RLS/schemas para aislamiento por tenant." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="postgres">
          <mxGeometry x="20" y="70" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Redis v7<br/><span style='color: #f6e05e; fontSize: 12;'>Caché</span>" style="rounded=1;html=1;fillColor:#fffbeb;strokeColor:#f6e05e;" vertex="1" parent="layer-infra">
          <mxGeometry x="20" y="90" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="redis-desc" value="Acceso O(1) para sesiones activas, caché de contexto conversacional en tiempo real, TTL automático." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="redis">
          <mxGeometry x="20" y="140" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="llm-gateway" value="LLM Gateway<br/><span style='color: #a855f7; fontSize: 12;'>Claude 3.5 Sonnet</span>" style="rounded=1;html=1;fillColor:#f5f3ff;strokeColor:#a855f7;" vertex="1" parent="layer-infra">
          <mxGeometry x="20" y="190" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="llm-desc" value="Proveedor principal para extracción de factores de riesgo psicoemocional, procesamiento sintomático y análisis de notas clínicas." style="html=1;fillColor=none;strokeColor=none;fontSize=10;whiteSpace=wrap;" vertex="1" parent="llm-gateway">
          <mxGeometry x="20" y="240" width="220" height="30" as="geometry"/>
        </mxCell>

