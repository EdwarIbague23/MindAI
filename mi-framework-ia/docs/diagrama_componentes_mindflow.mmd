graph TD
    classDef clientStyle fill:#e0f7fa,stroke:#006064,stroke-width:2px,color:#006064,font-weight:bold;
    classDef apiStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20,font-weight:bold;
    classDef coreStyle fill:#ede7f6,stroke:#512da8,stroke-width:2px,color:#311b92,font-weight:bold;
    classDef dataStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1,font-weight:bold;
    classDef aiStyle fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#e65100,font-weight:bold;

    subgraph subg_client ["Capa de Presentación (Frontend Híbrido)"]
        web_client["💻 Portal Web<br/>React + TypeScript"]:::clientStyle
        mobile_client["📱 App Móvil<br/>React Native"]:::clientStyle
    end

    subgraph subg_api ["Capa de API y Servidor"]
        fastapi_server["⚡ API REST FastAPI<br/>Python 3.11+ / Pydantic"]:::apiStyle
    end

    subgraph subg_core ["Capa de Orquestación y Lógica (Orchestrator Core)"]
        agent_registry["Registry & Router"]:::coreStyle
        planner_exec["Planner & Executor"]:::coreStyle
        llm_gateway["LLM Gateway<br/>(Claude 3.5 Sonnet)"]:::aiStyle
    end

    subgraph subg_security ["Capa de Privacidad"]
        pii_pipeline["🔒 Pipeline PII<br/>SpaCy + Regex + AES-256"]:::aiStyle
    end

    subgraph subg_data ["Capa de Persistencia Híbrida (Datos y Caché)"]
        postgres[(🗄 PostgreSQL v16<br/>SQLAlchemy & Alembic<br/>7 Tablas Clínicas)]:::dataStyle
        redis[(⚡ Redis v7<br/>Caché de Sesiones & TTL)]:::dataStyle
    end

    %% Conexiones Arquitectónicas Principales
    web_client -->|HTTPS / REST / OpenAPI| fastapi_server
    mobile_client -->|HTTPS / REST / OpenAPI| fastapi_server
    
    fastapi_server -->|Controlador y Peticiones| agent_registry
    agent_registry --> planner_exec
    
    planner_exec -->|Anonimización Obligatoria| pii_pipeline
    pii_pipeline -->|Inferencia Segura| llm_gateway
    
    planner_exec -->|ORM Queries & Migraciones| postgres
    fastapi_server -->|Gestión de Sesiones & Rate Limit| redis